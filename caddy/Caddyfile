# Listens on plain HTTP :3000 — the VPS panel's own reverse proxy terminates
# TLS for tabsa.in/www.tabsa.in at the edge and forwards here, so this Caddy
# instance is purely an internal router, not the public-facing SSL endpoint.
:3000 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:4000
	}

	handle /app/* {
		root * /srv
		try_files {path} /app/index.html
		file_server
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
