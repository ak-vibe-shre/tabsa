# APP_DIR must match the checkout path deploy.sh uses (default /home/tabsa).
tabsa.in, www.tabsa.in {
	handle /api/* {
		reverse_proxy 127.0.0.1:4000
	}

	handle /app/* {
		root * /home/tabsa/client/dist
		try_files {path} /app/index.html
		file_server
	}

	handle {
		root * /home/tabsa/client/dist
		try_files {path} /index.html
		file_server
	}
}
