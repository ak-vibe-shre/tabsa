# All services run with network_mode: host (required on this server — its
# Docker install doesn't publish container ports to the public interface
# correctly), so the backend is reached via 127.0.0.1 rather than Compose
# service-name DNS.
tabsa.in, www.tabsa.in {
	handle /api/* {
		reverse_proxy 127.0.0.1:4000
	}

	handle /app/* {
		root * /srv
		try_files {path} /app/index.html
		file_server
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
