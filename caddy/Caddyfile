{
    auto_https disable_redirects
}

tabsa.in, www.tabsa.in {
    handle /api/* {
        reverse_proxy 127.0.0.1:4000
    }

    handle /app/* {
        root * /srv
        try_files {path} /app/index.html
        file_server
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}